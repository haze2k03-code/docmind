# Copy this file to .env and fill in the values. Never commit .env.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here
# If Google retires this model, pick a current "flash" model name from AI Studio.
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Any long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars

# Used when you run the API directly on your laptop (Docker overrides it).
DATABASE_URL=postgres://docmind:docmind@localhost:5433/docmind

# The first admin account, created by `npm run seed`.
ADMIN_EMAIL=admin@docmind.local
ADMIN_PASSWORD=ChangeMe123!

# Set to true only when the app is served over HTTPS.
COOKIE_SECURE=false

# Retrieval tuning
TOP_K=5
MIN_SIMILARITY=0.55
